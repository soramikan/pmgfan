[Unit]
Description=pmgfan: PRIMERGY iRMC Fan Control Daemon
After=multi-user.target

[Service]
Type=notify
ExecStart=/usr/sbin/pmgfand \
    --config /etc/pmgfand/config.toml

# --config を渡して ExecStart と同じバックエンドで解除する
# （[device] backend = "native" 時も正しく ipmitool 非依存で解除できる）
ExecStopPost=/usr/sbin/pmgfand --config /etc/pmgfand/config.toml clear-override

# 最後の砦: config が削除/破損していると上の行自体が失敗する。
# 設定を読まない明示フラグで両バックエンドの解除を試みる。
# ExecStopPost は先行コマンドの失敗後も順に実行される。
ExecStopPost=-/usr/sbin/pmgfand --backend native --device /dev/ipmi0 clear-override
ExecStopPost=-/usr/sbin/pmgfand --backend ipmitool -I open clear-override

Restart=on-failure
RestartSec=2s

WatchdogSec=15s
TimeoutStopSec=10s

RuntimeDirectory=pmgfand
RuntimeDirectoryMode=0750
# キャリブレーション結果の保存先 /var/lib/pmgfand を作成する
# （ProtectSystem=strict 下でも書き込み可能になる）
StateDirectory=pmgfand
# ランタイム dir / socket を root:pmgfan にして非 root クライアント
# （pmgfan グループ）からアクセス可能にする。pmgfan グループが
# 存在しないと起動に失敗するので先に作成しておく
Group=pmgfan

# ProtectSystem=strict だと /etc が読み取り専用になり、
# TUI からの設定永続化（カーブ保存・スコープ切替）が失敗する。
# 設定ディレクトリだけ書き込み可にする。
ReadWritePaths=/etc/pmgfand

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
